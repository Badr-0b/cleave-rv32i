# Synthesis script for yosys created by qflow
read_liberty -lib -ignore_miss_dir -setattr blackbox /home/nitro/work/open_pdks/open_pdks/root/volare/sky130/build/c6d73a35f524070e85faff4a6a9eef49553ebc2b/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ff_n40C_1v95.lib
read_verilog  /mnt/c/Users/Nitro/Desktop/ASIC/Projects/cleave/source/tt_um_cleave.v
read_verilog  cleave_core.v
read_verilog  cleave_dmem.v
read_verilog  cleave_branch.v
read_verilog  cleave_alu.v
read_verilog  cleave_immgen.v
read_verilog  cleave_regfile.v
read_verilog  cleave_control.v
read_verilog  cleave_imem.v
read_verilog  cleave_pc.v

# High-level synthesis
synth -top tt_um_cleave
# Map register flops
dfflibmap -liberty /home/nitro/work/open_pdks/open_pdks/root/volare/sky130/build/c6d73a35f524070e85faff4a6a9eef49553ebc2b/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ff_n40C_1v95.lib
opt

# Map combinatorial cells, standard script
abc -exe /usr/local/share/qflow/bin/yosys-abc -liberty /home/nitro/work/open_pdks/open_pdks/root/volare/sky130/build/c6d73a35f524070e85faff4a6a9eef49553ebc2b/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__ff_n40C_1v95.lib -script +strash;scorr;ifraig;retime,{D};strash;dch,-f;map,-M,1,{D}
flatten
setundef -zero

clean -purge
hilomap -hicell sky130_fd_sc_hd__conb_1 HI
hilomap -locell sky130_fd_sc_hd__conb_1 LO
# Output buffering
iopadmap -outpad sky130_fd_sc_hd__buf_1 A:X -bits
# Cleanup
opt
clean
rename -enumerate
write_verilog  tt_um_cleave_mapped.v
stat
