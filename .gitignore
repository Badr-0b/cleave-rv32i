# ── Personal / tooling ───────────────────────────────────────────────
.claude/
.env
personalnotes.md
.DS_Store
.idea/

# ── Personal / AI-collaboration docs (kept locally, never committed) ──
# Handoffs, session writeups, runbooks, internal trackers, scratch notes.
# Filename patterns (no leading slash) so they match at the root and in
# ttsky-verilog-template/ alike. None are needed to build or test.
HANDOFF*.md
WHATS_NEXT.md
SESSION_WRITEUP*.md
PROJECT_STAGES.md
Project_tree.md
*runbook*.md

# ── Heavy working backups (regenerable snapshots) ────────────────────
cleave/archive_qflow_*.tar.gz

# ── Simulation / waveforms ───────────────────────────────────────────
*.vcd
*.fst
*.fst.hier
*.vvp
*.gtkw

# ── TinyTapeout template locals (from ttsky-verilog-template/.gitignore)
ttsky-verilog-template/docs/qflow-*.md
ttsky-verilog-template/runs/
ttsky-verilog-template/tt_submission/
ttsky-verilog-template/src/user_config.json
ttsky-verilog-template/src/config_merged.json
ttsky-verilog-template/test/sim_build/
ttsky-verilog-template/test/__pycache__/
ttsky-verilog-template/test/results.xml
ttsky-verilog-template/test/gate_level_netlist.v

# ── OpenLane / qflow build tree under cleave/ ────────────────────────
# Keep: the final GDS, run logs, the qflow archive, configs/scripts.
# Drop: the multi-GB OpenLane run tree + all P&R intermediates.
cleave/runs/
cleave/synthesis/
cleave/**/*.cel
cleave/**/*.cel.bak
cleave/**/*.def
cleave/**/*.spc
cleave/**/*.xspice
cleave/**/*.pin
cleave/**/*.pl1
cleave/**/*.pl2
cleave/**/*.obs
cleave/**/fillcells.txt

# In cleave/layout/, keep only the signed-off GDS
cleave/layout/*
!cleave/layout/
!cleave/layout/tt_um_cleave.gds
